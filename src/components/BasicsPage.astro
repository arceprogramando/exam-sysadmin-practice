---
import Base from "../layouts/Base.astro";
import { basicsFor, PUBLIC_DESK_VIDEO } from "../lib/environment-basics";
import { getUI, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUI(locale);
const basics = basicsFor(locale);
---

<Base title={basics.title} description={basics.description} locale={locale} route="basics">
  <div class="mx-auto max-w-5xl px-5 py-8">
    <p class="text-sm font-medium tracking-wide text-muted uppercase">/ {ui.basicsNav}</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">{basics.heading}</h1>
    <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-ink/90">{basics.body}</p>
    <p class="mt-6">
      <a
        class="text-ink underline decoration-line underline-offset-2"
        href={PUBLIC_DESK_VIDEO}
        target="_blank"
        rel="noopener noreferrer"
      >
        {basics.videoLink}
        <span class="sr-only">, {ui.opensNew}</span>
      </a>
    </p>
  </div>
</Base>
